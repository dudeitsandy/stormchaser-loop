.hud-root {
    width: 100%;
    height: 100%;
    align-items: flex-end;
    justify-content: flex-start;
    padding: 16px;
}

.hud-label {
    font-size: 24px;
    color: rgb(0, 0, 0);
    background-color: rgba(255, 255, 255, 0.7);
    margin-bottom: 4px;
    padding: 4px 8px;
}

.hud-score {
    font-size: 32px;
}
